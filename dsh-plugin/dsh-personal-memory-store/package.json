{
  "name": "dsh-personal-memory-store",
  "version": "1.0.0",
  "description": "Personal memory store tools for DSH: init and doctor a plain-text memory store per Personal Memory Store Specification 1.0.",
  "type": "module",
  "license": "MIT",
  "author": "zyx0407",
  "homepage": "https://github.com/zyx0407/personal-memory-store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyx0407/personal-memory-store.git"
  },
  "bugs": {
    "url": "https://github.com/zyx0407/personal-memory-store/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "personal-memory",
    "memory-store",
    "ai-memory"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
