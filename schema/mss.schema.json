{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mss.dev/schema/mss.schema.json",
  "title": "mss.json",
  "description": "Memory Store Specification 1.0 declaration file",
  "type": "object",
  "required": ["mss"],
  "properties": {
    "mss": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "store": {
      "enum": ["L0", "L1", "L2", "L3"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "topic": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    }
  },
  "additionalProperties": true
}
